# Smart Route Planner
# Create a free key at https://openrouteservice.org/ for real road routing.
# The stack still starts without it, but route quality may be limited.
ORS_API_KEY=
GATEWAY_PORT=8080
PLANNER_WEB_PORT=3000

# AI Explain + chatbot
JAGOOD_WEB_PORT=3001
OLLAMA_MODEL=qwen3:1.7b
AI_EXPLAIN_LLM_REASONING_EFFORT=none

# PostgreSQL
POSTGRES_PORT=5432
POSTGRES_USER=route_planner
POSTGRES_PASSWORD=route_planner
POSTGRES_DB=route_planner

# External weather data
BMKG_BASE_URL=https://peta-maritim.bmkg.go.id/public_api
BMKG_CACHE_TTL_SECONDS=10800
